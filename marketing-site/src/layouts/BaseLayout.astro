---
import '../styles/global.css';

const siteUrl = 'https://efficientlabs.ai';
const {
  title = 'Efficient Labs',
  description = 'Governed AI infrastructure for operators who refuse chaos.',
  canonicalPath = Astro.url.pathname,
  robots = 'noindex, nofollow',
  image = '/architecture-signal.svg'
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
// Default to the OG-image (1200×630 wordmark) for social-share previews.
// Pages can override by passing image="/path-to-other.png".
const ogImage = image === '/architecture-signal.svg' ? '/og-image.png' : image;
const imageUrl = new URL(ogImage, siteUrl).toString();

// JSON-LD Organization schema — emitted on every page so any indexable
// surface anchors back to the same canonical org identity.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Efficient Labs',
  url: siteUrl,
  logo: imageUrl,
  description: 'Sovereign AI infrastructure firm. Audits and builds for operators who refuse chaos.',
  founder: {
    '@type': 'Person',
    name: 'Michael Ward',
  },
  email: 'founder@efficientlabs.ai',
  sameAs: [
    'https://github.com/Neo-The-Architect/Efficient-Labs',
    'https://github.com/Neo-The-Architect/Orchestral',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Efficient Labs" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="128x128" href="/favicon.png" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Efficient Labs home">
        <span class="brand-mark" aria-hidden="true">EL</span>
        <span>Efficient Labs</span>
      </a>
      <nav class="nav" aria-label="Primary navigation">
        <a href="/audit/">Audit</a>
        <a href="/methodology/">Methodology</a>
        <a href="/case-studies/">Case studies</a>
        <a href="/about/">About</a>
        <a class="nav-cta" href="https://tally.so/r/81R2zr">Start intake</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Efficient Labs</strong>
        <p>Built in public. Client data private.</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="https://github.com/Neo-The-Architect/Efficient-Labs">GitHub</a>
        <a href="https://github.com/Neo-The-Architect/Orchestral">Orchestral</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </nav>
    </footer>
  </body>
</html>
